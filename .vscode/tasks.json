{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🚀 backend",
      "type": "shell",
      "command": "rm -rf .venv && python3 -m venv .venv && . .venv/bin/activate && pip install -r requirements.txt && uvicorn app.main:app --reload",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": []
    },
    {
      "label": "🌐 frontend",
      "type": "shell",
      "command": "flutter run -d web-server",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": []
    },
    {
      "label": "▶️ start-all",
      "dependsOn": [
        "🚀 backend",
        "🌐 frontend-web-server"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}