BUNCHIN_TOKEN_SECRET=replace-with-a-long-random-token-secret
BUNCHIN_ENCRYPTION_SECRET=replace-with-a-different-long-random-encryption-secret
BUNCHIN_DATABASE_URL=sqlite:///./bunchin.db
BUNCHIN_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173,http://localhost:8080
BUNCHIN_TIMEZONE=America/Sao_Paulo
BUNCHIN_ENFORCE_HTTPS=false
BUNCHIN_SEED_ON_STARTUP=true
BUNCHIN_SEED_ADMIN_PASSWORD=replace-with-a-seed-admin-password
BUNCHIN_BREVO_API_KEY=
BUNCHIN_BREVO_SENDER_EMAIL=
BUNCHIN_BREVO_SENDER_NAME=Bunchin
BUNCHIN_BREVO_WELCOME_ENABLED=true
